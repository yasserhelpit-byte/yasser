<% if (user && typeof shell !== 'undefined' && shell) { %>
    </main>
  </div>
</div>
<% } else { %>
</main>
<footer class="foot wrap">صُنع بـ <a href="/">YASSER</a> — منصة المتاجر الإلكترونية · <a href="/terms">الشروط</a> · <a href="/privacy">الخصوصية</a></footer>
<% } %>
<% if (user && typeof shell !== 'undefined' && shell) { %>
<script>window.CSRF = window.CSRF || <%- js(csrf) %>; window.VAPID_KEY = <%- js(vapidKey) %>;</script>
<script src="/dialog.js?v=<%= assetV %>"></script>
<script src="/notify.js?v=<%= assetV %>"></script>
<% } %>
<% if (user && typeof pendingOrders !== 'undefined') { %>
<div id="toast" class="toast" hidden></div>
<script>
// New-order alerts: poll every 30s, show a toast + browser notification + sound for orders we haven't seen.
(function () {
  const KEY = 'yasser:lastOrderId';
  const get = () => { try { return Number(localStorage.getItem(KEY)) || 0; } catch { return 0; } };
  const set = (v) => { try { localStorage.setItem(KEY, v); } catch {} };
  const baseTitle = document.title.replace(/^\(\d+\) /, '');
  function beep() {
    try { const c = new AudioContext(), o = c.createOscillator(), g = c.createGain(); o.connect(g); g.connect(c.destination);
      o.frequency.value = 880; g.gain.setValueAtTime(0.15, c.currentTime); g.gain.exponentialRampToValueAtTime(0.001, c.currentTime + 0.6); o.start(); o.stop(c.currentTime + 0.6); } catch {}
  }
  function show(o) {
    const t = document.getElementById('toast');
    t.innerHTML = '';
    const a = document.createElement('a');
    if (o.chat) {
      a.href = '/dashboard/stores/' + o.store_id + '/inbox/' + o.id;
      a.textContent = '💬 ' + o.customer_name + ': ' + String(o.text || '').slice(0, 80);
    } else {
      a.href = '/dashboard/stores/' + o.store_id + '/orders/' + o.id;
      a.textContent = '🛒 طلب جديد #' + o.id + ' من ' + o.customer_name + ' — ' + Number(o.total).toFixed(2) + ' ' + o.currency;
    }
    t.appendChild(a); t.hidden = false;
    setTimeout(() => (t.hidden = true), 15000);
    beep();
    // System notifications come from Web Push (sw.js), so the page only shows the toast.
  }
  async function poll(first) {
    try {
      const r = await fetch('/dashboard/notifications', { headers: { accept: 'application/json' } });
      if (!r.ok) return;
      const d = await r.json();
      document.title = (d.pending ? '(' + d.pending + ') ' : '') + baseTitle;
      const badge = document.getElementById('pending-badge');
      if (badge) badge.textContent = d.pending;
      // New chat messages
      if (d.latestChat) {
        const CK = 'yasser:lastChatMsg';
        let seen = 0; try { seen = Number(localStorage.getItem(CK)) || 0; } catch {}
        const onThread = location.pathname.endsWith('/inbox/' + d.latestChat.id);
        if (!first && d.latestChat.mid > seen && !onThread) show({ id: d.latestChat.id, chat: true, store_id: d.latestChat.store_id, customer_name: d.latestChat.name || 'زائر', text: d.latestChat.last_message, store_name: '' });
        try { localStorage.setItem(CK, d.latestChat.mid); } catch {}
      }
      if (window.YasserBell && typeof d.notesUnread === 'number') window.YasserBell.setCount(d.notesUnread);
      const cu = document.getElementById('chat-unread'); if (cu) { cu.textContent = d.unreadChats || ''; cu.hidden = !d.unreadChats; }
      if (d.latest) {
        if (!first && d.latest.id > get()) show(d.latest);
        if (first && !get()) set(d.latest.id);
        if (!first) set(d.latest.id);
      }
    } catch {}
  }
  poll(true);
  setInterval(() => poll(false), 30000);
})();
</script>
<% } %>
</body>
</html>
