<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' && title ? title + ' · ' : '' %><%= typeof font !== 'undefined' && store ? store.name : 'YASSER' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800<% if (typeof font !== 'undefined' && font.g !== 'Tajawal:wght@400;500;700;800') { %>&family=<%= font.g %><% } %>&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <% if (typeof store !== 'undefined' && store) { %><style>:root{--brand:<%= store.color %>;<% if (typeof font !== 'undefined') { %>--font:<%- font.css %>, 'Tajawal', system-ui, sans-serif;--radius:<%= radius %>;<% } %>}</style><% } %>
</head>
<body>
