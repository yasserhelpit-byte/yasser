<% if (b.type === 'contact_cta') {
  const go = b.mode === 'phone' ? (store.phone ? 'tel:' + store.phone.replace(/[^+\d]/g, '') : '') : b.mode === 'link' ? href(b.link) : (store.whatsapp ? wa(b.message || 'مرحباً') : '');
%>
<section data-idx="<%= b.idx %>" class="sec<%= sx(b) %> sec-cta" id="contact">
  <div class="cta-band">
    <div>
      <% if (b.title) { %><h2><%= b.title %></h2><% } %>
      <% if (b.text) { %><p><%= b.text %></p><% } %>
    </div>
    <% if (go) { %><a class="btn big light" href="<%= go %>" <%= /^https?:/.test(go) ? 'target=_blank rel=noopener' : '' %>><%= b.button || (b.mode === 'phone' ? '📞 اتصل بنا' : '💬 تواصل معنا') %></a>
    <% } else if (isOwner || (typeof preview !== 'undefined' && preview)) { %><small class="cta-warn">⚠️ أضف رقم <%= b.mode === 'phone' ? 'الهاتف' : 'واتساب' %> في إعدادات المتجر ليظهر الزر.</small><% } %>
