  <% cats.forEach((c, ci) => { %>
    <div class="menu-cat" id="menu-<%= bi %>-<%= ci %>">
      <h3><%= c.name %></h3>
      <div class="menu-list">
        <% c.items.forEach(it => { %>
          <div class="menu-item">
            <% if (it.image) { %><img src="<%= it.image %>" alt="" loading="lazy"><% } %>
            <div class="mi-body">
              <div class="mi-top"><strong><%= it.name %></strong><% if (it.tag) { %><em class="mi-tag"><%= it.tag %></em><% } %><span class="mi-dots"></span><% if (it.price) { %><b class="mi-price"><%= price(it.price) %></b><% } %></div>
              <% if (it.desc) { %><small><%= it.desc %></small><% } %>
            </div>
            <% if (b.order === 'whatsapp' && store.whatsapp) { %><a class="mi-add" href="<%= wa(`مرحباً، أريد طلب: ${it.name}${it.price ? ' (' + price(it.price) + ')' : ''}`) %>" target="_blank" rel="noopener" aria-label="اطلب <%= it.name %> عبر واتساب">+</a><% } %>
          </div>
        <% }) %>
      </div>
    </div>
  <% }) %>
  <% if (b.note) { %><p class="menu-note"><%= b.note %></p><% } %>
</section>
<% } %>

