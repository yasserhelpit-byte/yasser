    <div class="hours-card">
      <h3>📍 العنوان والتواصل</h3>
      <p class="pre"><%= b.address || store.city || '' %></p>
      <div class="hours-actions">
        <% if (b.map) { %><a class="btn small" href="<%= b.map %>" target="_blank" rel="noopener">🗺️ الاتجاهات</a><% } %>
        <% if (tel) { %><a class="btn small ghost" href="tel:<%= tel.replace(/[^+\d]/g, '') %>">📞 <span dir="ltr"><%= tel %></span></a><% } %>
        <% if (store.whatsapp) { %><a class="btn small wa" href="https://wa.me/<%= store.whatsapp %>" target="_blank" rel="noopener">💬 واتساب</a><% } %>
