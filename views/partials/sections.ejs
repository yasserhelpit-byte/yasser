      <article class="team-card">
        <% if (it.image) { %><img src="<%= it.image %>" alt="<%= it.name %>" loading="lazy"><% } else { %><span class="team-ph"><%= it.name.replace(/^د\.\s*/, '').trim().charAt(0) %></span><% } %>
        <h3><%= it.name %></h3>
        <% if (it.role) { %><span class="team-role"><%= it.role %></span><% } %>
