<% if (typeof preview !== 'undefined' && preview) { %>
<script>
// Design editor preview: scroll to and highlight the section being edited; keep clicks inside the preview.
addEventListener('message', (e) => {
  const el = document.querySelector('[data-idx="' + e.data?.focus + '"]');
  document.querySelectorAll('.pv-focus').forEach((x) => x.classList.remove('pv-focus'));
  if (el) { el.classList.add('pv-focus'); el.scrollIntoView({ behavior: e.data.instant ? 'auto' : 'smooth', block: 'start' }); }
});
document.addEventListener('click', (e) => { if (e.target.closest('a, button[type=submit], form button')) e.preventDefault(); }, true);
</script>
<% } %>
<% if (typeof pixels !== 'undefined' && pixels && !(typeof preview !== 'undefined' && preview)) { const hero = blocks.find(b => (b.type === 'product_hero' || b.type === 'order_form') && b.product); if (hero) { %>
<script>
window.yTrack && yTrack('ViewContent', <%- js({ value: hero.product.price, currency: store.currency, name: hero.product.name, contents: [{ id: hero.product.id, quantity: 1, price: hero.product.price }] }) %>);
document.querySelectorAll('.lo-form').forEach((f) => f.addEventListener('focusin', function once() {
  f.removeEventListener('focusin', once);
  window.yTrack && yTrack('InitiateCheckout', { value: Number(f.dataset.price), currency: f.dataset.cur, contents: [{ id: f.querySelector('[name=product_id]').value, quantity: 1, price: Number(f.dataset.price) }] });
}));
</script>
<% } } %>
<script>
// Landing pages: gallery thumbnails, quantity stepper, live total, ajax order, countdown.
document.querySelectorAll('.sec-ph .thumbs button').forEach((b) => b.addEventListener('click', () => {
  const box = b.closest('.ph-gallery'); box.querySelector('.ph-main img').src = b.dataset.src;
  box.querySelectorAll('.thumbs button').forEach((x) => x.classList.toggle('on', x === b));
}));
document.querySelectorAll('.lo-form').forEach((f) => {
  const qty = f.querySelector('[name=quantity]'), price = +f.dataset.price, fee = +f.dataset.fee, free = +f.dataset.free, cur = f.dataset.cur;
  const fmt = (n) => n.toFixed(2) + ' ' + cur;
  const update = () => {
    const q = Math.max(1, Math.min(+qty.max || 20, +qty.value || 1)); qty.value = q;
    const sub = q * price, ship = free > 0 && sub >= free ? 0 : fee;
    f.querySelector('.lo-sum').textContent = fmt(sub + ship);
    f.querySelector('.lo-ship').textContent = ship ? '(شامل التوصيل ' + fmt(ship) + ')' : '(التوصيل مجاني)';
  };
  f.querySelectorAll('[data-step]').forEach((b) => b.addEventListener('click', () => { qty.value = +qty.value + +b.dataset.step; update(); }));
  qty.addEventListener('input', update); update();
  f.addEventListener('submit', async (e) => {
    if (!window.fetch) return;
    e.preventDefault();
    const btn = f.querySelector('.lo-submit'), err = f.querySelector('.lo-err'), label = btn.textContent;
    btn.disabled = true; btn.textContent = 'جارٍ إرسال الطلب…'; err.hidden = true;
    try {
      const r = await fetch(f.action, { method: 'POST', body: new URLSearchParams(new FormData(f)), headers: { accept: 'application/json' } });
      const d = await r.json();
      if (d.redirect) { location.href = d.redirect; return; }
      err.textContent = d.error || 'تعذّر إرسال الطلب.'; err.hidden = false;
    } catch { err.textContent = 'تعذّر الاتصال. أعد المحاولة.'; err.hidden = false; }
    btn.disabled = false; btn.textContent = label;
  });
});
document.querySelectorAll('.cd-box').forEach((box) => {
  const end = +box.dataset.end, pad = (n) => String(n).padStart(2, '0');
  const tick = () => {
    const left = Math.max(0, end - Date.now());
    if (!left) { box.closest('.sec-cd').hidden = true; return clearInterval(t); }
    const s = Math.floor(left / 1000);
    box.querySelector('[data-u=d]').textContent = pad(Math.floor(s / 86400));
    box.querySelector('[data-u=h]').textContent = pad(Math.floor(s % 86400 / 3600));
    box.querySelector('[data-u=m]').textContent = pad(Math.floor(s % 3600 / 60));
    box.querySelector('[data-u=s]').textContent = pad(s % 60);
  };
  const t = setInterval(tick, 1000); tick();
});
// Hide the sticky order bar while an order form is on screen.
(() => {
  const bar = document.querySelector('.ph-sticky'); if (!bar || !('IntersectionObserver' in window)) return;
  const io = new IntersectionObserver((es) => bar.classList.toggle('away', es.some((e) => e.isIntersecting)), { threshold: 0.2 });
  document.querySelectorAll('.lo-form').forEach((f) => io.observe(f));
})();

// Before / after comparison.
document.querySelectorAll('.ba').forEach((box) => {
  const r = box.querySelector('input');
  const set = () => box.style.setProperty('--pos', r.value + '%');
  r.addEventListener('input', set); set();
});
// Reveal sections as they scroll into view.
(() => {
  const els = document.querySelectorAll('.rv');
  if (!els.length) return;
  if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  document.documentElement.classList.add('rv-on');
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
  els.forEach((el) => io.observe(el));
})();
// Auto-advancing slider with arrows, dots and swipe.
document.querySelectorAll('[data-slider]').forEach((el) => {
  const slides = el.querySelectorAll('.slide'), dots = el.querySelectorAll('.dots button');
  if (slides.length < 2) return;
  let i = 0, timer;
  const go = (n) => { slides[i].classList.remove('on'); dots[i]?.classList.remove('on'); i = (n + slides.length) % slides.length; slides[i].classList.add('on'); dots[i]?.classList.add('on'); };
  const auto = () => { clearInterval(timer); timer = setInterval(() => go(i + 1), 5500); };
  el.querySelector('.next').onclick = () => { go(i + 1); auto(); };
  el.querySelector('.prev').onclick = () => { go(i - 1); auto(); };
  dots.forEach((d, k) => (d.onclick = () => { go(k); auto(); }));
  let x0 = null;
  el.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  el.addEventListener('touchend', (e) => { if (x0 === null) return; const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) { go(i + (dx < 0 ? -1 : 1)); auto(); } x0 = null; });
  auto();
});
</script>
