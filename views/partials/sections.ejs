      <h3>🕘 أوقات العمل</h3>
      <table><% b.items.filter(it => it.day).forEach(it => { %><tr class="<%= /مغلق|closed|fermé/i.test(it.time) ? 'closed' : '' %>"><td><%= it.day %></td><td dir="auto"><%= it.time %></td></tr><% }) %></table>
