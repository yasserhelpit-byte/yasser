</main>
<footer class="shop-foot">
  <div class="wrap foot-grid">
    <div>
      <strong class="foot-name"><%= store.name %></strong>
      <% if (store.description) { %><p class="muted"><%= store.description %></p><% } %>
      <% if (store.city) { %><p class="muted">📍 <%= store.city %></p><% } %>
    </div>
    <div>
      <strong>روابط</strong>
      <% if (hasProducts) { %><p><a href="<%= base %>/products">كل المنتجات</a></p><% } %>
      <% menuPages.filter(p => p.in_footer).forEach(p => { %><p><a href="<%= base %>/page/<%= p.slug %>"><%= p.title %></a></p><% }) %>
    </div>
    <% if (store.phone || store.whatsapp || store.email) { %>
    <div>
      <strong>تواصل معنا</strong>
      <% if (store.phone) { %><p><a href="tel:<%= store.phone %>" dir="ltr">📞 <%= store.phone %></a></p><% } %>
      <% if (store.whatsapp) { %><p><a href="https://wa.me/<%= store.whatsapp %>" target="_blank" rel="noopener">💬 واتساب</a></p><% } %>
      <% if (store.email) { %><p><a href="mailto:<%= store.email %>">✉️ <%= store.email %></a></p><% } %>
    </div>
    <% } %>
    <% if (store.instagram || store.facebook || store.tiktok) { %>
    <div>
      <strong>تابعنا</strong>
      <div class="socials">
        <% if (store.instagram) { %><a href="<%= store.instagram %>" target="_blank" rel="noopener">Instagram</a><% } %>
        <% if (store.facebook) { %><a href="<%= store.facebook %>" target="_blank" rel="noopener">Facebook</a><% } %>
        <% if (store.tiktok) { %><a href="<%= store.tiktok %>" target="_blank" rel="noopener">TikTok</a><% } %>
      </div>
    </div>
    <% } %>
  </div>
  <div class="wrap muted small foot-bottom">© <%= new Date().getFullYear() %> <%= store.name %> · مدعوم بـ <a href="/" dir="ltr">YASSER BOUSSATTA</a></div>
</footer>
</div>
<% if (store.chat_enabled && !(typeof preview !== 'undefined' && preview)) { %>
<%- include('chat-widget') %>
<% } else if (store.whatsapp) { %>
<a class="wa-float" href="https://wa.me/<%= store.whatsapp %>?text=<%= encodeURIComponent('مرحباً، لدي سؤال عن متجر ' + store.name) %>" target="_blank" rel="noopener" aria-label="واتساب">
  <svg viewBox="0 0 24 24" width="28" height="28" fill="#fff"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.4-.3z"/></svg>
</a>
<% } %>
</body>
</html>
