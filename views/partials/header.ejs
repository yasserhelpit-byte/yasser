<%- include('head') %>
<% if (user && typeof shell !== 'undefined' && shell) { %>
<%
  const cur = typeof store !== 'undefined' && store ? store : null;
  const on = (href, exact) => (exact ? path === href : path === href || path.startsWith(href + '/')) ? 'on' : '';
  const sb = cur ? `/dashboard/stores/${cur.id}` : '';
%>
<div class="app">
  <aside class="sidebar" id="sidebar">
    <div class="side-top">
      <%- include('logo', { href: '/dashboard' }) %>
      <span class="side-bell"><%- include('bell') %></span>
      <button type="button" class="side-close" onclick="document.body.classList.remove('side-open')" aria-label="إغلاق">✕</button>
    </div>

    <% if (cur) { %>
    <details class="switcher">
      <summary>
        <span class="sw-avatar" style="background: <%= cur.color %>"><% if (cur.logo_url) { %><img src="<%= cur.logo_url %>" alt=""><% } else { %><%= cur.name.trim().charAt(0).toUpperCase() %><% } %></span>
        <span class="sw-name"><strong><%= cur.name %></strong><small dir="ltr">/s/<%= cur.slug %></small></span>
        <span class="sw-chev">⌄</span>
      </summary>
      <div class="sw-list">
        <% myStores.forEach(s => { %><a href="/dashboard/stores/<%= s.id %>" class="<%= s.id === cur.id ? 'on' : '' %>"><span class="sw-dot" style="background: <%= s.color %>"></span><%= s.name %></a><% }) %>
        <a href="/dashboard/stores/new" class="sw-new">+ متجر جديد</a>
      </div>
    </details>
    <nav class="side-nav">
      <a href="<%= sb %>" class="<%= on(sb, true) %>"><span>📊</span>نظرة عامة</a>
      <a href="<%= sb %>/orders" class="<%= on(sb + '/orders') %>"><span>🧾</span>الطلبات</a>
      <a href="<%= sb %>/products" class="<%= on(sb + '/products') %>"><span>📦</span>المنتجات</a>
      <a href="<%= sb %>/ads" class="<%= on(sb + '/ads') %>"><span>📣</span>الإعلانات</a>
      <a href="<%= sb %>/inbox" class="<%= on(sb + '/inbox') %>"><span>💬</span>الرسائل<b class="pending" id="chat-unread" <%= typeof unreadChats !== 'undefined' && unreadChats ? '' : 'hidden' %>><%= typeof unreadChats !== 'undefined' ? unreadChats : '' %></b></a>
      <div class="side-label">المتجر</div>
      <a href="<%= sb %>/design" class="<%= on(sb + '/design') %>"><span>🎨</span>التصميم</a>
      <a href="<%= sb %>/pages" class="<%= on(sb + '/pages') %>"><span>📄</span>الصفحات</a>
      <a href="<%= sb %>/payments" class="<%= on(sb + '/payments') %>"><span>💳</span>الدفع</a>
      <a href="<%= sb %>/settings" class="<%= on(sb + '/settings') %>"><span>⚙️</span>الإعدادات</a>
      <a href="<%= sb %>/domain" class="<%= on(sb + '/domain') %>"><span>🌐</span>النطاق<% if (cur.custom_domain && !cur.domain_verified) { %> <b class="pending" title="بانتظار التحقق">!</b><% } %></a>
      <a href="/s/<%= cur.slug %>" target="_blank"><span>↗</span>عرض المتجر</a>
    </nav>
    <% } %>

    <nav class="side-nav">
      <div class="side-label">عام</div>
      <a href="/dashboard" class="<%= on('/dashboard', true) %>"><span>🏪</span>متاجري
        <% if (typeof pendingOrders !== 'undefined' && pendingOrders) { %><b class="pending" id="pending-badge" title="طلبات جديدة"><%= pendingOrders %></b><% } %></a>
      <a href="/dashboard/settings/notifications" class="<%= on('/dashboard/settings/notifications') %>"><span>🔔</span>الإشعارات</a>
      <% if (!cur) { %><a href="/dashboard/stores/new" class="<%= on('/dashboard/stores/new', true) %>"><span>➕</span>متجر جديد</a><% } %>
      <% if (user.isAdmin) { %>
        <div class="side-label">الإدارة</div>
        <a href="/admin" class="<%= on('/admin', true) %>"><span>📈</span>نظرة عامة</a>
        <a href="/admin/stores" class="<%= on('/admin/stores') %>"><span>🏪</span>كل المتاجر</a>
        <a href="/admin/merchants" class="<%= on('/admin/merchants') %>"><span>👥</span>التجار</a>
        <a href="/admin/orders" class="<%= on('/admin/orders') %>"><span>🧾</span>كل الطلبات</a>
        <a href="/admin/settings" class="<%= on('/admin/settings') %>"><span>⚙️</span>إعدادات المنصة</a>
      <% } %>
    </nav>

    <% if (!user.isAdmin && (platform.support_whatsapp || platform.support_email)) { %>
    <a class="side-help" href="<%= platform.support_whatsapp ? 'https://wa.me/' + platform.support_whatsapp : 'mailto:' + platform.support_email %>" target="_blank" rel="noopener">🆘 تحتاج مساعدة؟ <small>تواصل مع فريق YASSER</small></a>
    <% } %>
    <div class="side-user">
      <span class="u-avatar"><%= user.name.trim().charAt(0).toUpperCase() %></span>
      <span class="u-info"><strong><%= user.name %></strong><small dir="ltr"><%= user.email %></small></span>
      <form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="u-out" title="خروج" aria-label="خروج"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg></button></form>
    </div>
  </aside>
  <div class="side-backdrop" onclick="document.body.classList.remove('side-open')"></div>

  <div class="app-main">
    <header class="app-top">
      <button type="button" class="burger" onclick="document.body.classList.add('side-open')" aria-label="القائمة"><span></span><span></span><span></span></button>
      <%- include('logo', { href: '/dashboard' }) %>
      <span class="top-bell"><%- include('bell') %></span>
    </header>
    <% if (platform.notice) { %>
    <div class="notice-bar n-<%= platform.notice_level %>" id="notice-bar" data-key="<%= require_hash(platform.notice) %>" hidden>
      <span>📢 <%= platform.notice %></span>
      <button type="button" aria-label="إخفاء" onclick="try { localStorage.setItem('yasser:notice', this.parentNode.dataset.key) } catch {} this.parentNode.hidden = true">✕</button>
    </div>
    <script>(function () { const b = document.getElementById('notice-bar'); let seen = ''; try { seen = localStorage.getItem('yasser:notice') } catch {} b.hidden = seen === b.dataset.key; })();</script>
    <% } %>
    <% if (typeof actingAs !== 'undefined' && actingAs) { %>
    <div class="acting-bar">🛡️ أنت تدير متجر التاجر <strong><%= actingAs.name %></strong> (<span dir="ltr"><%= actingAs.email %></span>) بصفتك مسؤولاً. أي تعديل هنا يغيّر متجره. <a href="/admin">← لوحة المسؤول</a></div>
    <% } %>
    <% if (cur && cur.suspended) { %>
    <div class="acting-bar off">⛔ هذا المتجر موقوف من إدارة المنصة ولا يظهر للعملاء. تواصل مع الإدارة لمعرفة السبب.</div>
    <% } %>
    <main class="app-content <%= typeof wide !== 'undefined' && wide ? 'wide' : '' %>">
<% } else { %>
<header class="topbar">
  <div class="wrap row">
    <%- include('logo', { href: '/' }) %>
    <nav class="row">
      <% if (user) { %>
        <a href="<%= user.isAdmin ? '/admin' : '/dashboard' %>">لوحة التحكم</a>
        <form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link">خروج</button></form>
      <% } else { %>
        <a href="/login">دخول</a>
        <a href="/signup" class="btn small">أنشئ متجرك</a>
      <% } %>
    </nav>
  </div>
</header>
<main class="wrap">
<% } %>
