<% const WA_ICON = '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm4.5 12.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.4-.3z"/></svg>'; %>
<div class="chat" id="chat" data-url="<%= base %>/chat">
  <div class="chat-panel" id="chat-panel" hidden role="dialog" aria-label="الدردشة مع <%= store.name %>">
    <div class="chat-head">
      <span class="chat-logo"><% if (store.logo_url) { %><img src="<%= store.logo_url %>" alt=""><% } else { %><%= store.name.trim().charAt(0).toUpperCase() %><% } %></span>
      <div class="chat-title"><strong><%= store.name %></strong><small><span class="dot-on"></span> نرد عادة خلال دقائق</small></div>
      <button type="button" class="chat-x" id="chat-close" aria-label="إغلاق">✕</button>
    </div>
    <div class="chat-body" id="chat-body">
      <div class="bubble them"><%= store.chat_greeting || 'مرحباً 👋 كيف يمكننا مساعدتك؟' %></div>
      <div class="chat-quick" id="chat-quick">
        <% ['هل التوصيل متوفر لمدينتي؟', 'كم تستغرق مدة التوصيل؟', 'أريد الاستفسار عن منتج', 'أريد تتبّع طلبي'].forEach(q => { %><button type="button"><%= q %></button><% }) %>
      </div>
      <div id="chat-msgs"></div>
    </div>
    <div class="chat-who" id="chat-who" hidden>
      <input id="chat-name" maxlength="60" placeholder="اسمك (اختياري)" autocomplete="name">
      <input id="chat-phone" maxlength="20" placeholder="هاتفك (اختياري)" inputmode="tel" dir="ltr" autocomplete="tel">
    </div>
    <form class="chat-form" id="chat-form">
      <textarea id="chat-input" rows="1" maxlength="1000" placeholder="اكتب رسالتك…" aria-label="رسالتك"></textarea>
      <button class="chat-send" aria-label="إرسال"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M2 21 23 12 2 3v7l15 2-15 2z" transform="scale(-1,1) translate(-24,0)"/></svg></button>
    </form>
    <% if (store.whatsapp) { %>
    <a class="chat-wa" href="https://wa.me/<%= store.whatsapp %>?text=<%= encodeURIComponent('مرحباً، لدي سؤال عن متجر ' + store.name) %>" target="_blank" rel="noopener"><%- WA_ICON %> تفضّل واتساب؟ تحدث معنا هناك</a>
    <% } %>
  </div>
  <button type="button" class="chat-fab" id="chat-fab" aria-label="تحدث معنا">
    <svg class="ic-open" viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M12 3C6.5 3 2 6.6 2 11c0 2.4 1.3 4.5 3.4 6L4.5 21l4.3-2.3c1 .2 2.1.3 3.2.3 5.5 0 10-3.6 10-8s-4.5-8-10-8z"/></svg>
    <svg class="ic-close" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 6l12 12M18 6 6 18"/></svg>
    <b class="chat-badge" id="chat-badge" hidden></b>
  </button>
</div>
<script>
(function () {
  const root = document.getElementById('chat'), url = root.dataset.url, csrf = <%- js(csrf) %>;
  const $ = (id) => document.getElementById(id);
  const panel = $('chat-panel'), msgs = $('chat-msgs'), body = $('chat-body'), input = $('chat-input');
  let last = 0, open = false, timer = null, started = false;
  const time = (iso) => { try { return new Date(iso).toLocaleTimeString('ar', { hour: '2-digit', minute: '2-digit' }); } catch { return ''; } };
  function add(m) {
    if (document.getElementById('m' + m.id)) return;
    last = Math.max(last, m.id);
    const d = document.createElement('div');
    d.id = 'm' + m.id;
    d.className = 'bubble ' + (m.sender === 'visitor' ? 'me' : 'them');
    d.textContent = m.body;
    const t = document.createElement('time'); t.textContent = time(m.created_at); d.appendChild(t);
    msgs.appendChild(d);
    started = true; $('chat-quick').hidden = true;
  }
  const scroll = () => (body.scrollTop = body.scrollHeight);
  async function poll() {
    try {
      const r = await fetch(url + '?after=' + last + (open ? '&read=1' : ''), { headers: { accept: 'application/json' } });
      if (!r.ok) return;
      const d = await r.json();
      d.messages.forEach(add);
      if (d.messages.length && open) scroll();
      const badge = $('chat-badge');
      badge.hidden = open || !d.unread; badge.textContent = d.unread || '';
      if (!started && !d.messages.length) $('chat-who').hidden = false;
    } catch {}
  }
  function schedule() { clearInterval(timer); timer = setInterval(poll, open ? 4000 : 20000); }
  function toggle(v) {
    open = v; panel.hidden = !v; root.classList.toggle('open', v);
    if (v) { poll().then(scroll); setTimeout(() => input.focus(), 50); }
    schedule();
  }
  $('chat-fab').onclick = () => toggle(!open);
  $('chat-close').onclick = () => toggle(false);
  async function send(text) {
    text = text.trim(); if (!text) return;
    input.value = ''; input.style.height = '';
    const fd = new URLSearchParams({ body: text, name: $('chat-name').value, phone: $('chat-phone').value });
    try {
      const r = await fetch(url, { method: 'POST', body: fd, headers: { 'x-csrf-token': csrf } });
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || 'تعذّر الإرسال');
      add(d.message); $('chat-who').hidden = true; scroll();
    } catch (e) {
      const err = document.createElement('div'); err.className = 'chat-err'; err.textContent = e.message; msgs.appendChild(err); scroll();
      input.value = text;
    }
  }
  $('chat-form').onsubmit = (e) => { e.preventDefault(); send(input.value); };
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(input.value); } });
  input.addEventListener('input', () => { input.style.height = ''; input.style.height = Math.min(input.scrollHeight, 120) + 'px'; });
  document.querySelectorAll('#chat-quick button').forEach((b) => (b.onclick = () => send(b.textContent)));
  poll(); schedule();
})();
</script>
