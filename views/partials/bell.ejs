<div class="bell">
  <button type="button" class="bell-btn" aria-label="الإشعارات">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
    <b class="bell-count" <%= typeof notesUnread !== 'undefined' && notesUnread ? '' : 'hidden' %>><%= typeof notesUnread !== 'undefined' ? notesUnread : '' %></b>
  </button>
  <div class="bell-panel" hidden>
    <div class="bell-head"><strong>الإشعارات</strong><button type="button" class="link bell-readall">تحديد الكل كمقروء</button></div>
    <div class="bell-list"></div>
    <div class="bell-foot" data-push-state>
      <button type="button" class="btn small full push-off-only" data-push-enable>📱 فعّل الإشعارات على هذا الجهاز</button>
      <span class="push-on-only">✓ الإشعارات مفعّلة على هذا الجهاز</span>
      <a href="/dashboard/settings/notifications" class="small">⚙️ إعدادات الإشعارات</a>
    </div>
  </div>
</div>
