<%- include('../partials/store-header', { title: store.name }) %>
</main>
<section class="shop-hero">
  <div class="wrap">
    <span class="shop-logo"><%= store.name.trim().charAt(0).toUpperCase() %></span>
    <h1><%= store.name %></h1>
    <p><%= store.description || 'مرحباً بك في متجرنا! تصفح منتجاتنا واطلب بسهولة.' %></p>
    <a href="#products" class="btn light big">تسوّق الآن ↓</a>
  </div>
</section>

<main class="wrap">
<section class="trust">
  <div><span>💵</span><div><strong>الدفع عند الاستلام</strong><small>ادفع عندما يصلك طلبك</small></div></div>
  <div><span>🚚</span><div><strong>توصيل سريع</strong><small>نوصل طلبك إلى باب منزلك</small></div></div>
  <div><span>📞</span><div><strong>تأكيد بالهاتف</strong><small>نتصل بك لتأكيد الطلب</small></div></div>
</section>

<section id="products">
  <form class="shop-tools" method="get" action="/s/<%= store.slug %>#products">
    <input type="search" name="q" value="<%= q %>" placeholder="🔍 ابحث عن منتج...">
    <select name="sort" onchange="this.form.submit()">
      <option value="new" <%= sort === 'new' ? 'selected' : '' %>>الأحدث</option>
      <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>السعر: من الأقل</option>
      <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>السعر: من الأعلى</option>
    </select>
    <button class="btn">بحث</button>
  </form>

  <p class="muted">
    <% if (q) { %><%= products.length %> نتيجة لـ «<%= q %>» · <a href="/s/<%= store.slug %>#products">عرض الكل</a>
    <% } else { %><%= total %> منتج<% } %>
  </p>

  <% if (!products.length) { %>
    <div class="card center empty">
      <div class="big-icon"><%= q ? '🔎' : '🛍️' %></div>
      <p class="muted"><%= q ? 'لا توجد منتجات مطابقة لبحثك.' : 'لا توجد منتجات حالياً، عد قريباً!' %></p>
    </div>
  <% } %>

  <div class="grid products">
    <% products.forEach(p => { %>
      <div class="card product <%= p.stock ? '' : 'soldout' %>">
        <a href="/s/<%= store.slug %>/p/<%= p.id %>" class="img">
          <% if (p.image_url) { %><img src="<%= p.image_url %>" alt="<%= p.name %>" loading="lazy"><% } else { %><span><%= p.name.trim().charAt(0) %></span><% } %>
          <% if (!p.stock) { %><em class="tag out">نفدت الكمية</em>
          <% } else if (p.id === newest) { %><em class="tag">جديد</em>
          <% } else if (p.stock <= 3) { %><em class="tag warn">بقي <%= p.stock %> فقط</em><% } %>
        </a>
        <a href="/s/<%= store.slug %>/p/<%= p.id %>" class="name"><%= p.name %></a>
        <p class="price"><%= money(p.price, store.currency) %></p>
        <% if (p.stock) { %>
          <form method="post" action="/s/<%= store.slug %>/cart">
            <%- include('../partials/csrf') %>
            <input type="hidden" name="product_id" value="<%= p.id %>">
            <input type="hidden" name="quantity" value="1">
            <button class="btn small full">🛒 أضف إلى السلة</button>
          </form>
        <% } else { %>
          <button class="btn small full" disabled>غير متوفر</button>
        <% } %>
      </div>
    <% }) %>
  </div>
</section>
</main>

<footer class="shop-foot">
  <div class="wrap row between">
    <div>
      <strong><%= store.name %></strong>
      <p class="muted"><%= store.description %></p>
    </div>
    <div class="muted small">مدعوم بـ <a href="/">YASSER</a></div>
  </div>
</footer>
</body>
</html>
