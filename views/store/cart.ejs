<%- include('../partials/store-header', { title: 'السلة' }) %>
<h1>سلة التسوق</h1>
<% if (!lines.length) { %>
  <section class="card center"><p>السلة فارغة.</p><a href="/s/<%= store.slug %>" class="btn">تصفح المنتجات</a></section>
<% } else { %>
<div class="table-wrap"><table>
  <tr><th>المنتج</th><th>السعر</th><th>الكمية</th><th>المجموع</th></tr>
  <% lines.forEach(l => { %>
  <tr>
    <td><%= l.product.name %></td>
    <td><%= money(l.product.price, store.currency) %></td>
    <td>
      <form method="post" action="/s/<%= store.slug %>/cart" class="row">
        <%- include('../partials/csrf') %>
        <input type="hidden" name="product_id" value="<%= l.product.id %>"><input type="hidden" name="mode" value="set">
        <input type="number" name="quantity" value="<%= l.quantity %>" min="0" max="<%= l.product.stock %>" class="qty">
        <button class="link">تحديث</button>
      </form>
    </td>
    <td><%= money(l.subtotal, store.currency) %></td>
  </tr>
  <% }) %>
  <tr><th colspan="3">الإجمالي</th><th><%= money(total, store.currency) %></th></tr>
</table></div>
<p class="row between"><a href="/s/<%= store.slug %>">← متابعة التسوق</a><a href="/s/<%= store.slug %>/checkout" class="btn big">إتمام الطلب</a></p>
<% } %>
<%- include('../partials/footer') %>
