<%- include('../partials/store-header', { title: 'السلة' }) %>
<h1>سلة التسوق</h1>
<% if (!lines.length) { %>
  <section class="card center empty"><div class="big-icon">🛒</div><p>السلة فارغة.</p><a href="<%= base || '/' %>" class="btn">تصفح المنتجات</a></section>
<% } else { %>
<section class="grid side">
  <div class="card cart-list">
    <% lines.forEach(l => { %>
    <div class="cart-line">
      <span class="thumb big"><% if (l.product.image_url) { %><img src="<%= l.product.image_url %>" alt=""><% } else { %><%= l.product.name.trim().charAt(0) %><% } %></span>
      <div class="grow">
        <a href="<%= base %>/p/<%= l.product.id %>"><strong><%= l.product.name %></strong></a>
        <% if (l.variant) { %><div class="variant"><%= l.variant %></div><% } %>
        <div class="muted small"><%= money(l.product.price, store.currency) %></div>
        <form method="post" action="<%= base %>/cart" class="row qty-form">
          <%- include('../partials/csrf') %>
          <input type="hidden" name="key" value="<%= l.key %>"><input type="hidden" name="mode" value="set">
          <input type="number" name="quantity" value="<%= l.quantity %>" min="0" max="<%= l.product.stock %>" class="qty" onchange="this.form.submit()" aria-label="الكمية">
          <button class="link danger" name="quantity" value="0">إزالة</button>
        </form>
      </div>
      <strong><%= money(l.subtotal, store.currency) %></strong>
    </div>
    <% }) %>
  </div>
  <div class="card">
    <h3>ملخص الطلب</h3>
    <%- include('../partials/totals') %>
    <a href="<%= base %>/checkout" class="btn big full">إتمام الطلب</a>
    <p class="center"><a href="<%= base || '/' %>">← متابعة التسوق</a></p>
  </div>
</section>
<% } %>
<%- include('../partials/store-footer') %>
