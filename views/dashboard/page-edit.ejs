<%- include('../partials/header', { title: page.title || 'صفحة' }) %>
<p><a href="/dashboard/stores/<%= store.id %>/pages">← الصفحات</a></p>
<div class="row between">
  <h1>📄 <%= page.title || 'صفحة جديدة' %></h1>
  <a href="/s/<%= store.slug %>/page/<%= page.slug %>" target="_blank" class="btn ghost">معاينة ↗</a>
</div>
<% if (saved) { %><div class="alert ok">✓ تم حفظ الصفحة.<% if (typeof stripped !== 'undefined' && stripped) { %> الأقسام الاحترافية لم تُحفظ: تتطلب باقة مدفوعة.<% } %></div><% } %>
<%- include('../partials/errors') %>
<form method="post" class="design-grid" id="page-form">
  <%- include('../partials/csrf') %>
  <input type="hidden" name="sections" id="sections-input">
  <section class="card">
    <h3>محتوى الصفحة</h3>
    <p class="muted small">ابنِ صفحتك بالأقسام: نصوص، صور، بانرات، معرض صور، أسئلة شائعة...</p>
    <div id="builder" class="builder"></div>
  </section>
  <aside class="design-side">
    <section class="card form">
      <h3>الإعدادات</h3>
      <label>عنوان الصفحة<input name="title" required maxlength="80" value="<%= page.title %>"></label>
      <label>الرابط<div class="prefix-input" dir="ltr"><span>/page/</span><input name="slug" value="<%= page.slug %>"></div></label>
      <label class="switch"><input type="checkbox" name="in_menu" value="1" <%= page.in_menu ? 'checked' : '' %>><span class="slider"></span> في القائمة العلوية</label>
      <label class="switch"><input type="checkbox" name="in_footer" value="1" <%= page.in_footer ? 'checked' : '' %>><span class="slider"></span> في أسفل المتجر</label>
    </section>
  </aside>
  <div class="save-bar pf-save"><button class="btn big">💾 حفظ الصفحة</button></div>
</form>
<script>window.CSRF = <%- js(csrf) %>; window.SCHEMA = <%- js(SCHEMA) %>; window.PRODUCTS = <%- js(productChoices) %>;</script>
<script src="/upload.js?v=<%= assetV %>"></script>
<script src="/builder.js?v=<%= assetV %>"></script>
<script>
const PRO_LOCKED = <%- js(typeof proLocked !== 'undefined' && proLocked) %>;
const builder = initBuilder({ root: document.getElementById('builder'), input: document.getElementById('sections-input'), data: <%- js(sectionsData) %>, uploadUrl: '/dashboard/stores/<%= store.id %>/uploads', proLocked: PRO_LOCKED });
const pageForm = document.getElementById('page-form');
pageForm.addEventListener('submit', async (e) => {
  if (!PRO_LOCKED || pageForm.dataset.proOk) return;
  const use = builder.proUsage();
  if (!use.any) return;
  e.preventDefault();
  builder.markDirty();
  const list = [...use.types.map((t) => '• قسم «' + t + '»'), ...(use.bg ? ['• خلفيات الأقسام الملوّنة'] : [])];
  const c = await yChoice(`هذه الصفحة تستعمل مزايا من الباقات المدفوعة:\n${list.join('\n')}\n\nيمكنك الترقية لنشرها، أو حفظ الصفحة بدونها.`, {
    title: '💎 مزايا احترافية في صفحتك', icon: '💎',
    buttons: [{ value: 'plans', label: '💎 شاهد الباقات (في نافذة جديدة)' }, { value: 'save', label: 'حفظ بدون المزايا الاحترافية', kind: 'ghost' }, { value: 'back', label: 'رجوع للتعديل', kind: 'ghost' }],
  });
  if (c === 'plans') window.open('/dashboard/stores/<%= store.id %>/billing', '_blank');
  if (c !== 'save') return;
  pageForm.dataset.proOk = '1';
  pageForm.requestSubmit();
});
</script>
<%- include('../partials/footer') %>
