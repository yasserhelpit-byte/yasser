<%- include('../partials/header', { title: 'إعدادات المتجر' }) %>
<% const v = values; const editing = !!(typeof store !== 'undefined' && store); %>
<div class="row between">
  <h1><%= editing ? '🎨 تخصيص المتجر' : 'متجر جديد' %></h1>
  <% if (editing) { %><a href="/s/<%= store.slug %>" target="_blank" class="btn ghost">معاينة المتجر ↗</a><% } %>
</div>
<%- include('../partials/errors') %>
<form method="post" action="<%= action %>" class="settings">
  <%- include('../partials/csrf') %>

  <section class="card form">
    <h3>📝 المعلومات الأساسية</h3>
    <label>اسم المتجر<input name="name" required maxlength="100" value="<%= v.name || '' %>"></label>
    <% if (editing) { %><p class="muted small">🌐 تريد نطاقاً خاصاً مثل <span dir="ltr">myshop.com</span>؟ <a href="/dashboard/stores/<%= store.id %>/domain">اربط نطاقك من هنا</a><% if (store.domain_verified) { %> · مربوط حالياً: <b dir="ltr"><%= store.custom_domain %></b><% } %></p><% } %>
    <label>رابط المتجر (أحرف إنجليزية وأرقام و -)
      <div class="prefix-input" dir="ltr"><span>/s/</span><input name="slug" placeholder="my-shop" value="<%= v.slug || '' %>"></div>
    </label>
    <label>شعار قصير يظهر في أعلى المتجر<input name="tagline" maxlength="120" placeholder="مثال: أجود المنتجات التقليدية المغربية" value="<%= v.tagline || '' %>"></label>
    <label>وصف المتجر<textarea name="description" rows="3" placeholder="عرّف عملاءك بمتجرك ومنتجاتك"><%= v.description || '' %></textarea></label>
  </section>

  <section class="card form">
    <h3>🎨 المظهر</h3>
    <div class="row">
      <label>لون المتجر<input name="color" type="color" value="<%= v.color || '#0f766e' %>"></label>
      <label>العملة<input name="currency" dir="ltr" maxlength="5" value="<%= v.currency || 'MAD' %>"></label>
    </div>
    <% if (editing) { %>
    <% [['logo_url', 'الشعار (اللوغو)', 'مربعة، 400×400 مثلاً'], ['banner_url', 'صورة الغلاف (البانر)', 'عريضة، 1600×600 مثلاً']].forEach(([field, label, hint]) => { %>
      <div class="img-field" data-field="<%= field %>">
        <span class="label"><%= label %> <small class="muted">· <%= hint %></small></span>
        <div class="img-field-row">
          <div class="img-box <%= field === 'banner_url' ? 'wide' : '' %>"><% if (v[field]) { %><img src="<%= v[field] %>" alt=""><% } else { %><span class="muted">لا توجد صورة</span><% } %></div>
          <div class="img-actions">
            <div class="dropzone mini" data-upload="/dashboard/stores/<%= store.id %>/uploads">
              <input type="file" accept="image/jpeg,image/png,image/webp,image/gif" hidden>
              <button type="button" class="btn small">📤 رفع صورة</button>
            </div>
            <button type="button" class="link danger remove-img">إزالة</button>
            <div class="dz-status"></div>
          </div>
        </div>
        <input type="hidden" name="<%= field %>" value="<%= v[field] || '' %>">
      </div>
    <% }) %>
    <% } else { %><p class="muted small">يمكنك رفع الشعار وصورة الغلاف بعد إنشاء المتجر.</p><% } %>
    <label>شريط الإعلانات أعلى المتجر<input name="announcement" maxlength="200" placeholder="مثال: 🎉 خصم 20% على كل المنتجات هذا الأسبوع" value="<%= v.announcement || '' %>"></label>
  </section>

  <section class="card form">
    <h3>🚚 التوصيل</h3>
    <div class="row">
      <label>سعر التوصيل (<%= v.currency || 'MAD' %>)<input name="shipping_fee" type="number" min="0" step="0.01" value="<%= v.shipping_fee || 0 %>"></label>
      <label>توصيل مجاني للطلبات فوق<input name="free_shipping_over" type="number" min="0" step="0.01" value="<%= v.free_shipping_over || 0 %>"></label>
    </div>
    <p class="muted small">اترك سعر التوصيل 0 إذا كان التوصيل مجانياً دائماً. واترك الحد 0 إذا لم يكن هناك توصيل مجاني.</p>
    <label>المدينة<input name="city" maxlength="100" placeholder="مثال: الدار البيضاء" value="<%= v.city || '' %>"></label>
  </section>

  <section class="card form">
    <h3>📊 التتبّع (Pixel)</h3>
    <p class="muted small">يخبر فيسبوك وتيك توك بمن زار متجرك ومن طلب، فتصل إعلاناتك لمن يشتري فعلاً. لا يعمل عندما تزور متجرك بنفسك.</p>
    <label>Facebook / Instagram Pixel ID<input name="fb_pixel_id" dir="ltr" inputmode="numeric" placeholder="123456789012345" value="<%= v.fb_pixel_id || '' %>"></label>
    <details class="ios-help"><summary>أين أجد رقم Pixel فيسبوك؟</summary><ol><li>افتح <a href="https://business.facebook.com/events_manager" target="_blank" rel="noopener">Events Manager</a> في فيسبوك.</li><li>اختر «ربط مصادر البيانات» ← «الويب» وأنشئ Pixel.</li><li>انسخ الرقم (حوالي 15 رقماً) والصقه هنا.</li></ol></details>
    <label>TikTok Pixel ID<input name="tiktok_pixel_id" dir="ltr" placeholder="C4XXXXXXXXXXXXXXXXXX" value="<%= v.tiktok_pixel_id || '' %>"></label>
    <details class="ios-help"><summary>أين أجد رقم Pixel تيك توك؟</summary><ol><li>افتح TikTok Ads Manager ← Tools ← Events.</li><li>أنشئ «Web Events» ← TikTok Pixel.</li><li>انسخ رقم Pixel والصقه هنا.</li></ol></details>
  </section>

  <section class="card form">
    <h3>📣 الإعلانات</h3>
    <p class="muted small">يستعملها Claude عند الضغط على «🚀 أطلق إعلاناً».</p>
    <label>لغة الإعلانات
      <select name="ad_language">
        <% [['darija', 'الدارجة المغربية (موصى بها)'], ['fusha', 'العربية الفصحى'], ['fr', 'Français']].forEach(([k, l]) => { %><option value="<%= k %>" <%= (v.ad_language || 'darija') === k ? 'selected' : '' %>><%= l %></option><% }) %>
      </select>
    </label>
    <div class="row">
      <label>الميزانية اليومية (<%= v.currency || 'MAD' %>)<input name="ad_daily_budget" type="number" min="10" step="5" value="<%= v.ad_daily_budget || 50 %>"></label>
      <label>عدد الأيام<input name="ad_days" type="number" min="1" max="60" value="<%= v.ad_days || 5 %>"></label>
    </div>
  </section>

  <section class="card form">
    <h3>📞 التواصل</h3>
    <label>رقم واتساب (مع رمز الدولة)<input name="whatsapp" dir="ltr" placeholder="212600000000" value="<%= v.whatsapp || '' %>"></label>
    <p class="muted small">يظهر زر واتساب عائم في متجرك، وزر «اطلب عبر واتساب» في صفحة كل منتج.</p>
    <div class="row">
      <label>رقم الهاتف<input name="phone" type="tel" dir="ltr" value="<%= v.phone || '' %>"></label>
      <label>البريد الإلكتروني<input name="email" type="email" dir="ltr" value="<%= v.email || '' %>"></label>
    </div>
  </section>

  <section class="card form">
    <h3>📱 مواقع التواصل الاجتماعي</h3>
    <p class="muted small">اكتب اسم المستخدم أو الرابط الكامل.</p>
    <label>Instagram<input name="instagram" dir="ltr" placeholder="@myshop" value="<%= v.instagram || '' %>"></label>
    <label>Facebook<input name="facebook" dir="ltr" placeholder="myshop" value="<%= v.facebook || '' %>"></label>
    <label>TikTok<input name="tiktok" dir="ltr" placeholder="@myshop" value="<%= v.tiktok || '' %>"></label>
  </section>

  <div class="save-bar"><button class="btn big">💾 حفظ</button></div>
</form>
<% if (editing) { %>
<script>window.CSRF = <%- js(csrf) %>;</script>
<script src="/upload.js?v=<%= assetV %>"></script>
<script>
document.querySelectorAll('.img-field').forEach((f) => {
  const hidden = f.querySelector('input[type=hidden]');
  const box = f.querySelector('.img-box');
  const zone = f.querySelector('.dropzone');
  const file = zone.querySelector('input[type=file]');
  const show = (src) => { hidden.value = src; box.innerHTML = src ? '<img alt="">' : '<span class="muted">لا توجد صورة</span>'; if (src) box.querySelector('img').src = src; };
  zone.querySelector('button').onclick = () => file.click();
  setupDropzone(zone, file, f.querySelector('.dz-status'), (urls) => show(urls[0]), () => 1);
  f.querySelector('.remove-img').onclick = () => show('');
});
</script>
<% } %>
<%- include('../partials/footer') %>
