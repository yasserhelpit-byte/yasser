<%- include('../partials/header', { title: store.name }) %>
<%
  const DAYS = ['الأحد','الإثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];
  const cur = store.currency;
  const sid = store.id;
  const published = products.filter(p => p.active).length;
  const lowStock = products.filter(p => p.active && p.stock <= 3);
  const steps = [
    { done: products.length > 0, icon: '📦', label: 'أضف أول منتج', hint: 'منتجاتك هي قلب متجرك', href: `/dashboard/stores/${sid}/products/new` },
    { done: !!store.logo_url, icon: '🏷️', label: 'ارفع شعار متجرك', hint: 'يظهر في أعلى المتجر', href: `/dashboard/stores/${sid}/settings` },
    { done: !!store.home_sections, icon: '🎨', label: 'صمّم الصفحة الرئيسية', hint: 'اختر قالباً وأضف صورك', href: `/dashboard/stores/${sid}/design` },
    { done: pageCount > 0, icon: '📄', label: 'أضف صفحة «من نحن»', hint: 'تبني ثقة العملاء', href: `/dashboard/stores/${sid}/pages` },
    { done: !!store.whatsapp, icon: '💬', label: 'أضف رقم واتساب', hint: 'ليتواصل معك العملاء', href: `/dashboard/stores/${sid}/settings` },
    { done: stats.count > 0, icon: '🚀', label: 'استقبل أول طلب', hint: 'شارك رابط متجرك', href: '#share' },
  ];
  const doneCount = steps.filter(s => s.done).length;
  const pct = Math.round(doneCount / steps.length * 100);
  const shareText = encodeURIComponent(`تسوّق من متجري ${store.name}: ${storeUrl}`);
  const hasSales = days.some(d => d.total > 0);
%>

<!-- Header -->
<div class="ov-head">
  <div class="ov-id">
    <span class="ov-logo" style="background: <%= store.color %>"><% if (store.logo_url) { %><img src="<%= store.logo_url %>" alt=""><% } else { %><%= store.name.trim().charAt(0).toUpperCase() %><% } %></span>
    <div>
      <div class="row ov-title"><h1><%= store.name %></h1><span class="badge <%= store.suspended ? 's-cancelled' : 's-delivered' %>"><%= store.suspended ? '● موقوف' : '● نشط' %></span></div>
      <p class="muted"><%= store.description || 'أضف وصفاً قصيراً لمتجرك من الإعدادات' %></p>
    </div>
  </div>
  <div class="row">
    <a href="/s/<%= store.slug %>" target="_blank" class="btn ghost">عرض المتجر ↗</a>
    <a href="/dashboard/stores/<%= sid %>/products/new" class="btn">+ منتج جديد</a>
  </div>
</div>

<%- include('../partials/push-banner') %>

<!-- KPIs -->
<section class="kpis">
  <div class="kpi"><span class="kpi-ic c1">💰</span><div><small>المبيعات</small><strong><%= money(stats.revenue, cur) %></strong><em>اليوم: <%= money(today.revenue, cur) %></em></div></div>
  <div class="kpi"><span class="kpi-ic c2">🧾</span><div><small>الطلبات</small><strong><%= stats.count %></strong><em>اليوم: <%= today.orders %></em></div></div>
  <a class="kpi <%= stats.pending ? 'alert-kpi' : '' %>" href="/dashboard/stores/<%= sid %>/orders"><span class="kpi-ic c3">⏳</span><div><small>بانتظار التأكيد</small><strong><%= stats.pending %></strong><em><%= stats.pending ? 'اضغط لمعالجتها ←' : 'لا شيء معلّق' %></em></div></a>
  <div class="kpi"><span class="kpi-ic c4">🛍️</span><div><small>متوسط قيمة الطلب</small><strong><%= money(stats.avg, cur) %></strong><em><%= published %> منتج منشور</em></div></div>
</section>

<% if (doneCount < steps.length) { %>
<!-- Setup -->
<section class="card setup">
  <div class="setup-head">
    <div class="ring" style="--p: <%= pct %>"><span><%= pct %>%</span></div>
    <div><h3>جهّز متجرك للانطلاق</h3><p class="muted"><%= doneCount %> من <%= steps.length %> خطوات مكتملة. أكمل الباقي ليبدو متجرك احترافياً.</p></div>
  </div>
  <div class="setup-grid">
    <% steps.forEach((s, i) => { %>
      <a href="<%= s.href %>" class="step <%= s.done ? 'done' : '' %>">
        <span class="step-ic"><%= s.done ? '✓' : s.icon %></span>
        <span><strong><%= s.label %></strong><small><%= s.done ? 'تم' : s.hint %></small></span>
      </a>
    <% }) %>
  </div>
</section>
<% } %>

<div class="ov-grid">
  <!-- Main column -->
  <div class="ov-col">
    <section class="card">
      <div class="card-head"><h3>المبيعات · آخر 7 أيام</h3><span class="muted small"><%= cur %></span></div>
      <% if (!hasSales) { %>
        <div class="chart-empty"><span>📈</span><p>ستظهر مبيعاتك هنا بعد أول طلب.</p></div>
      <% } else { %>
      <div class="bars">
        <% days.forEach(d => { %>
          <div class="bar" title="<%= d.day %>: <%= money(d.total, cur) %>">
            <small><%= d.total ? Math.round(d.total) : '' %></small>
            <span style="height: <%= Math.max(3, Math.round(d.total / max * 100)) %>%" class="<%= d.total ? '' : 'zero' %>"></span>
            <em><%= DAYS[new Date(d.day + 'T12:00:00Z').getUTCDay()] %></em>
          </div>
        <% }) %>
      </div>
      <% } %>
    </section>

    <section class="card">
      <div class="card-head"><h3>آخر الطلبات</h3><a href="/dashboard/stores/<%= sid %>/orders">عرض الكل ←</a></div>
      <% if (!orders.length) { %>
        <div class="chart-empty"><span>📭</span><p>لا توجد طلبات بعد. شارك رابط متجرك لتبدأ.</p></div>
      <% } else { %>
        <div class="list">
          <% orders.slice(0, 6).forEach(o => { %>
            <a class="list-row" href="/dashboard/stores/<%= sid %>/orders/<%= o.id %>">
              <span class="list-av"><%= o.customer_name.trim().charAt(0) %></span>
              <span class="list-main"><strong><%= o.customer_name %></strong><small>#<%= o.id %> · <%= o.created_at.slice(0, 16) %></small></span>
              <span class="badge s-<%= o.status %>"><%= STATUSES[o.status] %></span>
              <strong class="list-amt"><%= money(o.total, cur) %></strong>
            </a>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>

  <!-- Side column -->
  <div class="ov-col">
    <section class="card share-card" id="share">
      <h3>🔗 رابط متجرك</h3>
      <div class="copy-row">
        <input id="store-url" readonly dir="ltr" value="<%= storeUrl %>" onclick="this.select()">
        <button type="button" class="btn small" onclick="navigator.clipboard.writeText(document.getElementById('store-url').value).then(() => { this.textContent = '✓'; setTimeout(() => this.textContent = 'نسخ', 2000) })">نسخ</button>
      </div>
      <a class="btn wa full" target="_blank" rel="noopener" href="https://wa.me/?text=<%= shareText %>">مشاركة على واتساب</a>
    </section>

    <section class="card">
      <h3>⚡ إجراءات سريعة</h3>
      <div class="quick">
        <a href="/dashboard/stores/<%= sid %>/products/new"><span>📦</span>منتج جديد</a>
        <a href="/dashboard/stores/<%= sid %>/design"><span>🎨</span>التصميم</a>
        <a href="/dashboard/stores/<%= sid %>/pages"><span>📄</span>الصفحات</a>
        <a href="/dashboard/stores/<%= sid %>/settings"><span>⚙️</span>الإعدادات</a>
      </div>
    </section>

    <section class="card">
      <h3>🏆 الأكثر مبيعاً</h3>
      <% if (!topProducts.length) { %>
        <p class="muted small">ستظهر هنا منتجاتك الأكثر مبيعاً بعد أول طلب.</p>
      <% } else { topProducts.forEach((t, i) => { %>
        <div class="top-row"><b><%= i + 1 %></b><span><%= t.name %></span><small class="muted"><%= t.qty %> مبيع</small></div>
      <% }) } %>
    </section>

    <% if (lowStock.length) { %>
    <section class="card warn-card">
      <h3>⚠️ مخزون منخفض</h3>
      <% lowStock.slice(0, 5).forEach(p => { %>
        <p class="row between"><a href="/dashboard/stores/<%= sid %>/products/<%= p.id %>"><%= p.name %></a><span class="badge <%= p.stock ? 's-confirmed' : 's-cancelled' %>"><%= p.stock ? 'متبقي ' + p.stock : 'نفد' %></span></p>
      <% }) %>
    </section>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
