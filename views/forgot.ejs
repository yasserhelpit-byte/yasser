<%- include('partials/header', { title: 'نسيت كلمة المرور' }) %>
<section class="card narrow">
  <h1>🔑 نسيت كلمة المرور؟</h1>
  <% if (sent) { %>
    <div class="alert ok">إذا كان البريد <strong dir="ltr"><%= values.email %></strong> مسجلاً لدينا، فستصلك رسالة فيها رابط لتعيين كلمة مرور جديدة. الرابط صالح لمدة ساعة.</div>
    <p class="muted">لم تصلك الرسالة؟ تحقق من مجلد الرسائل غير المرغوب فيها (Spam).</p>
    <a href="/login" class="btn ghost">العودة لتسجيل الدخول</a>
  <% } else { %>
    <p class="muted">أدخل بريدك الإلكتروني وسنرسل لك رابطاً لتعيين كلمة مرور جديدة.</p>
    <%- include('partials/errors') %>
    <form method="post" action="/forgot" class="form">
      <%- include('partials/csrf') %>
      <label>البريد الإلكتروني<input name="email" type="email" required dir="ltr" value="<%= values.email || '' %>"></label>
      <button class="btn">إرسال الرابط</button>
    </form>
    <p class="muted"><a href="/login">← العودة لتسجيل الدخول</a></p>
  <% } %>
</section>
<%- include('partials/footer') %>
