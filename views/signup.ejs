<%- include('partials/header', { title: 'إنشاء حساب' }) %>
<section class="card narrow">
  <div class="auth-logo"><%- include('partials/logo', { href: '/', cls: 'big' }) %></div>
  <h1>إنشاء حساب تاجر</h1>
  <% if (platform.signups_open !== '1') { %>
    <div class="alert">التسجيل مغلق حالياً. عد لاحقاً<% if (platform.support_email) { %> أو راسلنا على <span dir="ltr"><%= platform.support_email %></span><% } %>.</div>
    <p class="muted">لديك حساب؟ <a href="/login">سجّل الدخول</a></p>
  <% } else { %>
  <%- include('partials/errors') %>
  <form method="post" action="/signup" class="form">
    <%- include('partials/csrf') %>
    <label>الاسم<input name="name" required value="<%= values.name || '' %>"></label>
    <label>البريد الإلكتروني<input name="email" type="email" required dir="ltr" value="<%= values.email || '' %>"></label>
    <label>كلمة المرور<input name="password" type="password" required minlength="8" dir="ltr"></label>
    <label class="check"><input type="checkbox" name="accept_terms" value="1" required> <span>أوافق على <a href="/terms" target="_blank">شروط الاستخدام</a> و<a href="/privacy" target="_blank">سياسة الخصوصية</a></span></label>
    <button class="btn">إنشاء الحساب</button>
  </form>
  <p class="muted">لديك حساب؟ <a href="/login">سجّل الدخول</a></p>
  <% } %>
</section>
<%- include('partials/footer') %>
