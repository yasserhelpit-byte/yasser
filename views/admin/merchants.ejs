<%- include('../partials/header', { title: 'التجار' }) %>
<%- include('nav', { heading: 'التجار', sub: merchants.length + ' حساب' }) %>
<form class="shop-tools" method="get">
  <input type="search" name="q" value="<%= q %>" placeholder="🔍 ابحث بالاسم أو البريد...">
  <button class="btn">بحث</button>
</form>
<div class="table-wrap"><table class="admin-table">
  <tr><th>الحساب</th><th>المتاجر</th><th>الطلبات</th><th>التسجيل</th><th>آخر دخول</th><th>الحالة</th><th></th></tr>
  <% merchants.forEach(m => { %>
  <tr class="<%= m.suspended ? 'row-off' : '' %>">
    <td><a class="prod-cell" href="/admin/merchants/<%= m.id %>">
      <span class="list-av"><%= m.name.trim().charAt(0).toUpperCase() %></span>
      <span><strong><%= m.name %></strong><% if (m.role === 'admin') { %> <span class="badge s-new">مسؤول</span><% } %><br><small class="muted" dir="ltr"><%= m.email %></small></span>
    </a></td>
    <td><%= m.store_count %></td>
    <td><%= m.order_count %></td>
    <td class="muted small"><%= m.created_at.slice(0, 10) %></td>
    <td class="muted small"><%= m.last_seen ? m.last_seen.slice(0, 10) : '—' %></td>
    <td><span class="badge <%= m.suspended ? 's-cancelled' : 's-delivered' %>"><%= m.suspended ? 'موقوف' : 'نشط' %></span></td>
    <td><a href="/admin/merchants/<%= m.id %>" class="btn small ghost">التفاصيل</a></td>
  </tr>
  <% }) %>
</table></div>
<%- include('../partials/footer') %>
