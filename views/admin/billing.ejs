<%- include('../partials/header', { title: 'الاشتراكات' }) %>
<%
  const fmt = (n) => Number(n).toLocaleString('fr-FR');
  const planName = (k) => k === 'trial' ? 'تجريبية' : (plans.find(p => p.key === k) || { name: k }).name;
  const stateBadge = { free: ['s-cancelled', 'مجانية'], trial: ['s-new', 'تجريبي'], active: ['s-delivered', 'فعّال'], expiring: ['s-confirmed', 'ينتهي قريباً'], grace: ['s-shipped', 'مهلة'] };
  const counts = stores.reduce((a, s) => (a[s.sub.state] = (a[s.sub.state] || 0) + 1, a), {});
%>
<div class="page-head-row"><div>
  <h1>💎 الاشتراكات</h1>
  <p class="muted">فعّل باقات التجار بعد التأكد من الدفع. التفعيل يمدّد الاشتراك من تاريخ انتهائه إذا جدّد التاجر نفس الباقة مبكراً. عند انتهاء أي اشتراك يرجع المتجر تلقائياً إلى الباقة المجانية.</p>
</div></div>
<% if (saved) { %><div class="alert ok">✓ تم حفظ إعدادات الباقات.</div><% } %>

<section class="grid four stats">
  <div class="card stat"><span class="icon">🕓</span><span class="muted">طلبات بانتظارك</span><strong><%= pending.length %></strong></div>
  <div class="card stat"><span class="icon">💰</span><span class="muted">مداخيل هذا الشهر</span><strong><%= fmt(monthIncome) %> درهم</strong></div>
  <div class="card stat"><span class="icon">✅</span><span class="muted">متاجر مشتركة</span><strong><%= (counts.active || 0) + (counts.expiring || 0) %></strong></div>
  <div class="card stat"><span class="icon">🎁</span><span class="muted">مجانية / في التجربة</span><strong><%= counts.free || 0 %> / <%= counts.trial || 0 %></strong></div>
</section>

<h2>🕓 طلبات بانتظار التفعيل</h2>
<% if (!pending.length) { %>
  <div class="card center empty"><div class="big-icon">🎉</div><p class="muted">لا توجد طلبات معلّقة.</p></div>
<% } %>
<% pending.forEach(b => { %>
<section class="card sub-req">
  <div class="sub-req-head">
    <div>
      <a href="/admin/stores/<%= b.store_id %>"><strong><%= b.store_name %></strong></a> <small class="muted">/s/<%= b.slug %></small>
      <div class="muted small"><%= b.owner_name %> · <span dir="ltr"><%= b.owner_email %></span> · طُلب <%= b.created_at.slice(0, 16) %></div>
    </div>
    <div class="sub-req-amt"><strong><%= fmt(b.amount) %> درهم</strong><small><%= planName(b.plan) %> · <%= PLAN_PERIODS[b.months] ? PLAN_PERIODS[b.months].label : b.months + ' أشهر' %> · <%= PAY_WAYS[b.method] %></small></div>
  </div>
  <p class="small">المرجع: <code dir="ltr"><%= ref(b) %></code><% if (b.note) { %> · ملاحظة التاجر: «<%= b.note %>»<% } %></p>
  <div class="sub-req-actions">
    <form method="post" action="/admin/billing/<%= b.id %>/approve" class="sub-approve" data-confirm="سيُفعَّل اشتراك «<%= b.store_name %>» ويصل للتاجر إشعار. تأكد أن المبلغ وصلك." data-confirm-title="تفعيل الباقة؟" data-confirm-ok="✓ تفعيل" data-confirm-icon="💎">
      <%- include('../partials/csrf') %>
      <select name="plan" aria-label="الباقة"><% paidPlans.forEach(p => { %><option value="<%= p.key %>" <%= p.key === b.plan ? 'selected' : '' %>><%= p.name %></option><% }) %></select>
      <select name="months" aria-label="المدة"><% Object.entries(PLAN_PERIODS).forEach(([m, p]) => { %><option value="<%= m %>" <%= Number(m) === b.months ? 'selected' : '' %>><%= p.label %></option><% }) %></select>
      <input name="amount" type="number" min="0" step="1" value="<%= b.amount %>" aria-label="المبلغ المستلم" title="المبلغ المستلم">
      <input name="reference" maxlength="80" placeholder="رقم الوصل (اختياري)" dir="auto">
      <button class="btn">✓ تفعيل</button>
    </form>
    <form method="post" action="/admin/billing/<%= b.id %>/reject" class="inline" data-confirm="سيُرفض الطلب ويصل للتاجر إشعار." data-confirm-title="رفض الطلب؟" data-confirm-ok="رفض" data-danger>
      <%- include('../partials/csrf') %><input type="hidden" name="reason" value=""><button class="btn ghost danger-btn">رفض</button>
    </form>
  </div>
</section>
<% }) %>

<h2>🏪 كل المتاجر</h2>
<div class="table-wrap"><table>
  <tr><th>المتجر</th><th>التاجر</th><th>الباقة</th><th>الحالة</th><th>حتى</th><th>تفعيل سريع</th></tr>
  <% stores.forEach(s => { const [cls, lbl] = stateBadge[s.sub.state]; %>
  <tr>
    <td><a href="/admin/stores/<%= s.id %>"><%= s.name %></a></td>
    <td><%= s.owner_name %></td>
    <td><%= s.sub.label %></td>
    <td><span class="badge <%= cls %>"><%= lbl %></span></td>
    <td><%= s.sub.until ? s.sub.until.slice(0, 10) : '—' %></td>
    <td>
      <form method="post" action="/admin/stores/<%= s.id %>/plan" class="sub-quick" data-confirm="سيُفعَّل الاشتراك لمتجر «<%= s.name %>» ويصل للتاجر إشعار." data-confirm-title="تفعيل الباقة؟" data-confirm-ok="✓ تفعيل" data-confirm-icon="💎">
        <%- include('../partials/csrf') %>
        <select name="plan"><% paidPlans.forEach(p => { %><option value="<%= p.key %>" <%= p.key === s.plan ? 'selected' : '' %>><%= p.name %></option><% }) %></select>
        <select name="months"><% Object.entries(PLAN_PERIODS).forEach(([m, p]) => { %><option value="<%= m %>"><%= p.label %></option><% }) %></select>
        <input type="hidden" name="method" value="cash"><input type="hidden" name="amount" value="">
        <button class="btn small">تفعيل</button>
      </form>
    </td>
  </tr>
  <% }) %>
</table></div>

<% if (recent.length) { %>
<h2>🧾 آخر العمليات</h2>
<div class="table-wrap"><table>
  <tr><th>التاريخ</th><th>المتجر</th><th>الباقة</th><th>المدة</th><th>المبلغ</th><th>الطريقة</th><th>الحالة</th></tr>
  <% recent.forEach(b => { %>
  <tr><td><%= (b.decided_at || b.created_at).slice(0, 16) %></td><td><a href="/admin/stores/<%= b.store_id %>"><%= b.store_name %></a></td><td><%= planName(b.plan) %></td><td><%= b.months %> شهر</td>
    <td><%= fmt(b.amount) %> درهم</td><td><%= PAY_WAYS[b.method] || b.method %><%= b.reference ? ' · ' + b.reference : '' %></td>
    <td><span class="badge <%= b.status === 'approved' ? 's-delivered' : 's-cancelled' %>"><%= b.status === 'approved' ? 'مفعّل' : 'مرفوض' %></span></td></tr>
  <% }) %>
</table></div>
<% } %>

<h2 id="settings">⚙️ إعدادات الباقات</h2>
<form method="post" action="/admin/billing/settings" class="card form">
  <%- include('../partials/csrf') %>
  <div class="grid three sub-edit">
    <% plans.forEach((p, i) => { %>
    <fieldset class="sub-edit-card">
      <legend><%= ['🆓', '🥈', '🥇'][i] %> <%= p.free ? 'الباقة المجانية' : 'الباقة ' + (i + 1) %></legend>
      <label>الاسم<input name="plan<%= i %>_name" value="<%= p.name %>" maxlength="40" required></label>
      <% if (p.free) { %><p class="muted small">💡 هذه هي الباقة المجانية: سعرها 0 دائماً، ويعود إليها أي متجر انتهى اشتراكه.</p>
      <% } else { %><label>السعر الشهري (درهم)<input name="plan<%= i %>_price" type="number" min="0" value="<%= p.price %>" required></label><% } %>
      <label>عدد المنتجات (0 = غير محدود)<input name="plan<%= i %>_products" type="number" min="0" value="<%= p.products %>"></label>
      <label>إعلانات الذكاء الاصطناعي شهرياً <small class="muted">(عند تفعيلها)</small><input name="plan<%= i %>_ai" type="number" min="0" value="<%= p.ai %>"></label>
      <label class="switch"><input type="checkbox" name="plan<%= i %>_domain" value="1" <%= p.domain ? 'checked' : '' %>><span class="slider"></span> نطاق خاص</label>
      <label class="switch"><input type="checkbox" name="plan<%= i %>_templates" value="1" <%= p.templates ? 'checked' : '' %>><span class="slider"></span> القوالب الاحترافية</label>
      <label class="switch"><input type="radio" name="featured" value="<%= p.key %>" <%= p.featured ? 'checked' : '' %>><span class="slider"></span> «الأكثر اختياراً»</label>
      <label>المميزات (كل ميزة في سطر)<textarea name="plan<%= i %>_features" rows="6"><%= p.features %></textarea></label>
    </fieldset>
    <% }) %>
  </div>
  <div class="grid three">
    <label>أيام تجربة المزايا الاحترافية للمتاجر الجديدة (0 = بدون تجربة: يبدأ المتجر على الباقة المجانية)<input name="trial_days" type="number" min="0" max="365" value="<%= cfg.trialDays %>"></label>
    <label>أيام المهلة قبل الرجوع إلى المجانية<input name="grace_days" type="number" min="0" max="60" value="<%= cfg.graceDays %>"></label>
  </div>
  <label>تعليمات الدفع للتجار (رقم الحساب، اسم المستفيد، العنوان…)
    <textarea name="billing_info" rows="5" placeholder="البنك: …&#10;صاحب الحساب: …&#10;RIB: …&#10;أو الدفع نقداً في مكتبنا: …"><%= cfg.info %></textarea>
  </label>
  <p class="muted small">تظهر هذه التعليمات للتاجر بعد طلب الاشتراك. رقم واتساب الدعم يُضبط في <a href="/admin/settings">إعدادات المنصة</a>.</p>
  <button class="btn">💾 حفظ إعدادات الباقات</button>
</form>
<%- include('../partials/footer') %>
