<%- include('../partials/header', { title: 'المتاجر' }) %>
<%- include('nav', { heading: 'كل المتاجر', sub: stores.length + ' متجر' }) %>
<form class="shop-tools" method="get" action="/admin/stores">
  <input type="search" name="q" value="<%= q %>" placeholder="🔍 ابحث باسم المتجر أو التاجر أو البريد أو النطاق...">
  <select name="f" onchange="this.form.submit()">
    <% [['all', 'كل المتاجر'], ['active', 'النشطة'], ['suspended', 'الموقوفة'], ['empty', 'بدون منتجات'], ['domain', 'بنطاق خاص']].forEach(([k, l]) => { %>
      <option value="<%= k %>" <%= filter === k ? 'selected' : '' %>><%= l %></option>
    <% }) %>
  </select>
  <button class="btn">بحث</button>
</form>
<% if (q) { %><p class="muted"><a href="/admin/stores">مسح البحث</a></p><% } %>

<% if (!stores.length) { %>
  <div class="card center empty"><div class="big-icon">🏪</div><p class="muted">لا توجد متاجر مطابقة.</p></div>
<% } else { %>
<div class="table-wrap"><table class="admin-table">
  <tr><th>المتجر</th><th>التاجر</th><th>المنتجات</th><th>الطلبات</th><th>المبيعات</th><th>آخر طلب</th><th>الحالة</th><th></th></tr>
  <% stores.forEach(s => { %>
  <tr class="<%= s.suspended ? 'row-off' : '' %>">
    <td><a class="prod-cell" href="/admin/stores/<%= s.id %>">
      <span class="thumb" style="background: <%= s.color %>; color: #fff"><% if (s.logo_url) { %><img src="<%= s.logo_url %>" alt=""><% } else { %><%= s.name.trim().charAt(0).toUpperCase() %><% } %></span>
      <span><strong><%= s.name %></strong><br><small class="muted" dir="ltr"><%= s.domain_verified ? s.custom_domain : '/s/' + s.slug %></small></span>
    </a></td>
    <td><%= s.owner_name %><br><small class="muted" dir="ltr"><%= s.owner_email %></small></td>
    <td><%= s.product_count %></td>
    <td><%= s.order_count %></td>
    <td><%= money(s.revenue, s.currency) %></td>
    <td class="muted small"><%= s.last_order ? s.last_order.slice(0, 10) : '—' %></td>
    <td><span class="badge <%= s.suspended ? 's-cancelled' : 's-delivered' %>"><%= s.suspended ? 'موقوف' : 'نشط' %></span></td>
    <td><a href="/admin/stores/<%= s.id %>" class="btn small ghost">التفاصيل</a></td>
  </tr>
  <% }) %>
</table></div>
<% } %>
<%- include('../partials/footer') %>
