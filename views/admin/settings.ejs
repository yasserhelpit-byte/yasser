<%- include('../partials/header', { title: 'إعدادات المنصة' }) %>
<%- include('nav', { heading: 'إعدادات المنصة' }) %>
<% if (saved) { %><div class="alert ok">✓ تم الحفظ.</div><% } %>
<form method="post" class="settings">
  <%- include('../partials/csrf') %>
  <section class="card form">
    <h3>⚖️ البيانات القانونية</h3>
    <p class="muted small">تظهر في <a href="/terms" target="_blank">شروط الاستخدام</a> و<a href="/privacy" target="_blank">سياسة الخصوصية</a>. ⚠️ النصوص نموذج أولي: راجعها مع مختص قبل الإطلاق.</p>
    <label>الاسم القانوني (الشركة أو المقاول الذاتي)<input name="legal_name" maxlength="120" placeholder="YASSER" value="<%= platform.legal_name %>"></label>
    <label>العنوان<input name="legal_address" maxlength="300" placeholder="المدينة، العنوان" value="<%= platform.legal_address %>"></label>
    <label class="check"><input type="checkbox" name="legal_bump" value="1"> تحديث «آخر تحديث» إلى تاريخ اليوم</label>
  </section>
  <section class="card form">
    <h3>👤 التسجيل</h3>
    <label class="switch"><input type="checkbox" name="signups_open" value="1" <%= platform.signups_open === '1' ? 'checked' : '' %>><span class="slider"></span> السماح بتسجيل تجار جدد</label>
    <p class="muted small">عند الإغلاق تظهر صفحة التسجيل برسالة «التسجيل مغلق حالياً»، ويبقى التجار الحاليون قادرين على الدخول.</p>
  </section>
  <section class="card form">
    <h3>✨ الإعلانات الذكية (Claude)</h3>
    <% if (!ai.configured) { %><div class="alert">⚠️ مفتاح Claude غير مضبوط على الخادم (المتغير <code>ANTHROPIC_API_KEY</code>). التجار يحصلون على إعلانات تجريبية فقط.</div>
    <% } else { %><div class="alert ok">✓ Claude متصل (<span dir="ltr"><%= ai.model %></span>). هذا الشهر: <strong><%= ai.n %></strong> إعلان · التكلفة التقديرية <strong dir="ltr">$<%= ai.cost.toFixed(2) %></strong> من سقف <span dir="ltr">$<%= ai.settings.ai_cap_usd_month %></span></div><% } %>
    <label class="switch"><input type="checkbox" name="ai_enabled" value="1" <%= platform.ai_enabled === '1' ? 'checked' : '' %>><span class="slider"></span> تفعيل زر «🚀 أطلق إعلاناً» للتجار</label>
    <div class="row">
      <p class="muted small">🎯 عدد الإعلانات لكل متجر شهرياً يُحدَّد الآن حسب باقته، من <a href="/admin/billing#settings">إعدادات الباقات</a>.</p>
      <label>سقف التكلفة الشهري للمنصة ($)<input name="ai_cap_usd_month" type="number" min="0" step="1" dir="ltr" value="<%= platform.ai_cap_usd_month %>"></label>
    </div>
    <p class="muted small">عند الوصول إلى السقف يتوقف الزر لكل المتاجر حتى بداية الشهر القادم.</p>
  </section>
  <section class="card form">
    <h3>📢 إعلان لكل التجار</h3>
    <p class="muted small">يظهر شريطاً أعلى لوحة تحكم كل التجار (مثلاً: صيانة، ميزة جديدة، عرض). اتركه فارغاً لإخفائه.</p>
    <textarea name="notice" rows="3" maxlength="400" placeholder="مثال: 🎉 أضفنا الدردشة المباشرة! فعّلها من صفحة الرسائل."><%= platform.notice %></textarea>
    <div class="seg">
      <% [['info', 'ℹ️ معلومة'], ['success', '🎉 خبر جيد'], ['warning', '⚠️ تنبيه']].forEach(([k, l]) => { %>
        <label><input type="radio" name="notice_level" value="<%= k %>" <%= platform.notice_level === k ? 'checked' : '' %>><span><%= l %></span></label>
      <% }) %>
    </div>
  </section>
  <section class="card form">
    <h3>🆘 دعم التجار</h3>
    <p class="muted small">يظهر رابط «تحتاج مساعدة؟» في القائمة الجانبية لكل التجار.</p>
    <div class="row">
      <label>رقم واتساب الدعم<input name="support_whatsapp" dir="ltr" placeholder="212600000000" value="<%= platform.support_whatsapp %>"></label>
      <label>بريد الدعم<input name="support_email" type="email" dir="ltr" placeholder="support@yasser.ma" value="<%= platform.support_email %>"></label>
    </div>
  </section>
  <div class="save-bar"><button class="btn big">💾 حفظ</button></div>
</form>
<%- include('../partials/footer') %>
